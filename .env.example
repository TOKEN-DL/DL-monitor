# 服务端口
PORT=3000

# OpenRouter 配置（必填，没有将无法做 AI 分析）
# 获取：https://openrouter.ai/keys
OPENROUTER_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=DL-monitor
# 默认模型（可用免费模型；如要换可在下方覆盖）
OPENROUTER_CLASSIFY_MODEL=google/gemma-3-4b-it:free
OPENROUTER_SUMMARIZE_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Web Push VAPID（首次启动自动生成在下方；如需手动生成：npm run gen-vapid）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 邮件推送（SMTP）— 留空则不发邮件
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# 数据源开关（1=启用 0=禁用）
SOURCE_HACKERNEWS=1
SOURCE_GITHUB=1
SOURCE_HUGGINGFACE=1
SOURCE_ARXIV=1
SOURCE_TWITTER=0

# Twitter / twitterapi.io（SOURCE_TWITTER=1 时生效）
# 在 https://twitterapi.io 注册拿 API Key（新用户 $0.1 免费额度）
TWITTER_API_KEY=
# 监控的 Twitter 搜索关键词（逗号分隔），最多 5 个
TWITTER_QUERIES=Claude,GPT-5,DeepSeek,Qwen

# GitHub Personal Access Token（可选，配置后 search 端点限流 10→30 req/min）
# 在 https://github.com/settings/tokens 生成（仅勾 public_repo）
GITHUB_TOKEN=

# 抓取频率（cron 表达式，Asia/Shanghai）
CRON_HACKERNEWS=*/10 * * * *
CRON_GITHUB=*/30 * * * *
CRON_HUGGINGFACE=*/30 * * * *
CRON_ARXIV=0 */1 * * *
CRON_TWITTER=*/20 * * * *