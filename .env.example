# DL-monitor 配置

# 服务端口
PORT=3000

# OpenRouter 配置（必填）
OPENROUTER_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=DL-monitor
# 默认模型（已审计可用）
OPENROUTER_CLASSIFY_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_SUMMARIZE_MODEL=meta-llama/llama-3.3-70b-instruct

# Web Push VAPID（启动自动生成）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 邮件推送（可选）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# ========== 数据源开关 ==========
SOURCE_HACKERNEWS=1
SOURCE_GITHUB=1
SOURCE_HUGGINGFACE=1
SOURCE_ARXIV=1
SOURCE_TWITTER=0
SOURCE_BILIBILI=1
SOURCE_GOOGLE=1
SOURCE_ZHIHU_TRENDS=1             # 知乎热搜词（公开 API 免 KEY）
SOURCE_WEIBO_TRENDS=0             # 微博热搜（需自部署 RSSHub 实例；默认禁用）

# ========== Twitter / twitterapi.io ==========
# 在 https://twitterapi.io 注册拿 API Key（新用户 $0.1 免费额度）
TWITTER_API_KEY=
# 监控的 Twitter 搜索关键词（逗号分隔，最多 5 个）
TWITTER_QUERIES=Claude,GPT-5,DeepSeek,Qwen
# 质量过滤阈值
TWITTER_MIN_FOLLOWERS=5000    # 粉丝数阈值（白名单跳过）
TWITTER_MIN_VIEWS=2000         # 浏览量阈值（白名单跳过）

# ========== B站（按关键词搜索视频 + UP主；@xxx 关键词自动走账号识别） ==========
# SESSDATA 从浏览器 cookie 复制（提高搜索限额到 1000+/天；不配也能用但限额 100/天）
# 浏览器 F12 → Application → Cookies → 选 SESSDATA
BILIBILI_SESSDATA=
BILIBILI_QUERIES=Claude,GPT-5,DeepSeek,Cursor
BILIBILI_MIN_PLAYS=2000         # 视频播放量阈值
BILIBILI_MIN_FOLLOWERS=5000     # UP主粉丝阈值（视频作者与账号识别共用）

# ========== Google News RSS（免费，无需 key） ==========
GOOGLE_QUERIES=Claude,GPT-5,DeepSeek

# ========== 微博热搜（占位；需 RSSHub 实例才启用） ==========
# 当 WEIBO_TRENDS_RSSHUB_URL 配置时，自动从该 RSSHub 拉取 /weibo/search/hot
WEIBO_TRENDS_RSSHUB_URL=

# ========== 账号识别（@xxx 关键词走 B站 UP主查询） ==========
# 频率：默认每小时第 7 分钟（cron 表达式）
CRON_ACCOUNT_RESOLVE=7 * * * *

# ========== 各源时间窗（小时） ==========
# 6h 窗口对低频源（arXiv / HuggingFace）几乎为空，建议 ≥168h
WINDOW_HACKERNEWS=24
WINDOW_GITHUB=24
WINDOW_HUGGINGFACE=168
WINDOW_ARXIV=168
WINDOW_BILIBILI=168        # B站视频时间窗：6h 太严（中文 AI 圈 1-3 天发酵，搜索 API 也混入老视频），168h 命中率最高
WINDOW_GOOGLE=6
WINDOW_TWITTER=6

# ========== 各老源代理指标阈值 ==========
HN_MIN_SCORE=50                 # HackerNews score
HN_MIN_DESCENDANTS=20           # HackerNews 评论数
GITHUB_MIN_STARS=200            # GitHub 仓库 stars
HF_MIN_DOWNLOADS=1000           # HuggingFace 模型下载量

# GitHub Personal Access Token（可选，配置后 search 端点限流 10→30 req/min）
GITHUB_TOKEN=

# ========== 抓取频率（cron 表达式，Asia/Shanghai） ==========
CRON_HACKERNEWS=*/10 * * * *
CRON_GITHUB=*/30 * * * *
CRON_HUGGINGFACE=*/30 * * * *
CRON_ARXIV=0 */1 * * *
CRON_TWITTER=*/15 * * * *
CRON_BILIBILI=*/15 * * * *
CRON_GOOGLE=*/30 * * * *
CRON_ZHIHU_TRENDS=*/15 * * * *
CRON_WEIBO_TRENDS=0 */1 * * *
# 用户新增信息源（SourcePanel 中手动添加）共享此 cron
CRON_USER_SOURCES=13,43 * * * *

# ========== 信息保留策略（3-tier retention） ==========
# Hot      — fetched_at 在 windowDays 天内 → 主 feed 显示
# Archived — 超 windowDays 且 views >= archiveViews → DB 保留但隐藏
# Deleted  — 超 windowDays 且 views <  archiveViews → 物理删除（白名单豁免）
#
# 阈值参考：@OpenAI GPT-5 / @AnthropicAI Claude 4 发布推文 3M+ views
#         KOL 反应推文 100K-1M views
#         一般新闻 / 小账号 10K-50K views
# → 100K (10万) 作为"重要模型发布相关"基准
RETENTION_ENABLED=1
RETENTION_WINDOW_DAYS=7          # 活跃窗口：默认 7 天
RETENTION_ARCHIVE_VIEWS=100000   # 归档阈值：默认 10万 views
CRON_RETENTION=37 3 * * *        # 每天凌晨 03:37 执行保留策略

# ========== 前端显示阈值 ==========
# 低于 DISPLAY_MIN_IMPORTANCE 的条目不进主 feed（未评分 NULL 条目放行）
DISPLAY_MIN_IMPORTANCE=0.5       # AI 重要度阈值（0-1）